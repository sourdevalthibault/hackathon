X_train = ensure_id_col(read_csv(ROOT / "X_train.csv"))
X_test  = ensure_id_col(read_csv(ROOT / "X_test.csv"))

train_ready = ensure_id_col(read_csv(ROOT / "train_features_ready.csv"))
test_ready  = ensure_id_col(read_csv(ROOT / "test_features_ready.csv"))

audio_scored = ensure_id_col(read_csv(ROOT / "audio_features_scored.csv"))
dynamisme    = ensure_id_col(read_csv(ROOT / "features_dynamisme.csv"))
lumisat      = ensure_id_col(read_csv(ROOT / "features_net_luminosité_saturation.csv"))

top_colors_train = ensure_id_col(read_csv(ROOT / "features_top_colors_train.csv"))
top_colors_test  = ensure_id_col(read_csv(ROOT / "features_top_colors_test.csv"))

# ---------------------------
# 4) Préfixer pour éviter collisions
# ---------------------------
def add_prefix_except_id(df, prefix):
    df = df.copy()
    rename = {c: f"{prefix}{c}" for c in df.columns if c != "ID"}
    return df.rename(columns=rename)

audio_scored     = add_prefix_except_id(audio_scored, "aud_")
dynamisme        = add_prefix_except_id(dynamisme, "dyn_")
lumisat          = add_prefix_except_id(lumisat, "lum_")
top_colors_train = add_prefix_except_id(top_colors_train, "col_")
top_colors_test  = add_prefix_except_id(top_colors_test, "col_")

# ---------------------------
# 5) FEProcessor sur X_train/X_test
# ---------------------------
redundant_from_ready = [
    "aspect_ratio", "video_duration", "release_year", "text_len",
    "nb_hashtags", "nb_emojis", "nb_mentions", "hashtag_density", "emoji_density",
    "feat_meteo", "feat_cta", "feat_action",
    "lang_lang_detected_de", "lang_lang_detected_en", "lang_lang_detected_es",
    "lang_lang_detected_fr", "lang_lang_detected_it", "lang_lang_detected_unknown"
]

fe = FEProcessor()  # drop_cols par défaut, ID préservé dans fit_transform/transform

X_train_fe = fe.fit_transform(X_train)
X_test_fe  = fe.transform(X_test)

# Mettre ID en 1ère colonne
X_train_fe = X_train_fe[["ID"] + [c for c in X_train_fe.columns if c != "ID"]]
X_test_fe  = X_test_fe[["ID"]  + [c for c in X_test_fe.columns  if c != "ID"]]

# Nettoyer redondances avec train_ready/test_ready
X_train_fe = X_train_fe.drop(columns=[c for c in redundant_from_ready if c in X_train_fe.columns], errors="ignore")
X_test_fe  = X_test_fe.drop(columns=[c for c in redundant_from_ready if c in X_test_fe.columns], errors="ignore")

print("✅ X_train_fe shape:", X_train_fe.shape, "| ID present:", "ID" in X_train_fe.columns)
print("✅ X_test_fe shape :", X_test_fe.shape,  "| ID present:", "ID" in X_test_fe.columns)

# ---------------------------
# 6) Build DF finaux = ready + FE + autres features
# ---------------------------
train_full = train_ready.copy()
test_full  = test_ready.copy()

# Merge FE
train_full = safe_merge(train_full, X_train_fe, how="left")
test_full  = safe_merge(test_full,  X_test_fe,  how="left")

# Merge audio/dyn/lumi/colors
train_full = safe_merge(train_full, audio_scored,     how="left")
train_full = safe_merge(train_full, dynamisme,         how="left")
train_full = safe_merge(train_full, lumisat,           how="left")
train_full = safe_merge(train_full, top_colors_train,  how="left")

test_full  = safe_merge(test_full,  audio_scored,      how="left")
test_full  = safe_merge(test_full,  dynamisme,          how="left")
test_full  = safe_merge(test_full,  lumisat,            how="left")
test_full  = safe_merge(test_full,  top_colors_test,    how="left")

# Virer colonnes doublons suffixées
train_full = drop_duplicate_suffix_cols(train_full)
test_full  = drop_duplicate_suffix_cols(test_full)

# ---------------------------
# 7) Sanity checks
# ---------------------------
def report(df, name):
    print(f"\n{name}: shape={df.shape}")
    print("ID nulls:", df["ID"].isna().sum())
    print("IDs uniques:", df["ID"].nunique(), "/", len(df))

report(train_full, "train_full")
report(test_full,  "test_full")

